# Copy to .env and fill in what you use. Never commit .env.

# --- Alert rule ---------------------------------------------------------------
# Alert on earthquakes of at least this magnitude (default 4.0).
EQ_MIN_MAGNITUDE=4.0
# Optional: your location. When set, only events within EQ_RADIUS_KM alert and
# the message includes the distance to the epicentre. Leave empty to alert on
# any qualifying event in the Romania region.
EQ_LATITUDE=
EQ_LONGITUDE=
EQ_RADIUS_KM=300

# --- Polling ------------------------------------------------------------------
EQ_POLL_INTERVAL_SECONDS=30
# Events older than this are ignored (default 60 minutes).
EQ_MAX_EVENT_AGE_MINUTES=60
# Comma-separated, in priority order. Available: infp, emsc, usgs
EQ_SOURCES=infp,emsc,usgs
# Where already-alerted events are remembered across restarts.
# Default: ~/.local/state/eq-notifier/seen-events.json
EQ_STATE_FILE=

# --- Notifications ------------------------------------------------------------
# Comma-separated. Available: ntfy, telegram, twilio
EQ_NOTIFIERS=ntfy

# ntfy (https://ntfy.sh): install the app, subscribe to a hard-to-guess topic.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Telegram: create a bot with @BotFather, open a chat with it and SEND IT A MESSAGE,
# then read "chat":{"id":...} from https://api.telegram.org/bot<TOKEN>/getUpdates
# (empty "result" means no message was sent yet). For a private chat the id equals
# your own user id, which @userinfobot will tell you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio SMS (paid): E.164 numbers, e.g. +40712345678
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
